            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
        }

        /* 动态渐变背景层 */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 10% 20%, rgba(67, 233, 123, 0.3) 0%, transparent 60%),
                radial-gradient(ellipse 60% 50% at 90% 80%, rgba(56, 249, 215, 0.25) 0%, transparent 60%),
                radial-gradient(ellipse 50% 40% at 50% 50%, rgba(102, 126, 234, 0.15) 0%, transparent 60%);
            animation: bgShift 12s ease-in-out infinite alternate;
            z-index: 0;
        }

        /* 浮动装饰圆 */
        .bg-circle {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.25;
            animation: float 18s ease-in-out infinite alternate;
            z-index: 0;
            pointer-events: none;
        }

        .bg-circle:nth-child(1) {
            width: 500px;
            height: 500px;
            background: #43e97b;
            top: -150px;
            left: -100px;
            animation-duration: 20s;
        }

        .bg-circle:nth-child(2) {
            width: 400px;
            height: 400px;
            background: #38f9d7;
            bottom: -120px;
            right: -80px;
            animation-duration: 16s;
            animation-delay: -4s;
        }

        .bg-circle:nth-child(3) {
            width: 300px;
            height: 300px;
            background: #667eea;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            animation-duration: 22s;
            animation-delay: -8s;
        }

        /* 网格纹理叠加 */
        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background-image:
                linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 60px 60px;
            z-index: 0;
            pointer-events: none;
        }

        @keyframes bgShift {
            0%   { transform: scale(1) rotate(0deg); }
            100% { transform: scale(1.08) rotate(3deg); }
        }

        @keyframes float {
            0%   { transform: translate(0, 0) scale(1); }
            33%  { transform: translate(30px, -40px) scale(1.1); }
            66%  { transform: translate(-20px, 20px) scale(0.95); }
            100% { transform: translate(10px, -30px) scale(1.05); }
        }

        .register-container {
            position: relative;
            z-index: 1;
            background: rgba(255, 255, 255, 0.93);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            padding: 40px;
